# Copy to .env (git-ignored) or export in your shell. Read by the justfile's gpu-* recipes.
# ssh target of the CUDA host that runs SfM, splats and renders
SHORELINE_GPU_HOST=
# working directory on that host; caches, envs and outputs all live under it
SHORELINE_GPU_ROOT=
# optional: systemd unit to stop during gpu-overnight to free VRAM (needs passwordless sudo for it)
SHORELINE_STOP_SERVICE=
