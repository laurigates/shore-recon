# Copy to .env (git-ignored) or export in your shell. Read by the justfile's recipes.
# host tools file for shoreline-recon (ADR-0003, ADR-0009), e.g. configs/<host>.local.toml
SHORELINE_TOOLS=
# optional: datasets (configs/<name>.toml) for `just batch`, `just demo` and `just bundle`;
# default: every config in configs/ with a [dataset] table whose input exists
SHORELINE_DATASETS=
# optional: the demo title card and bundle README, e.g. "Pier, City" and "drone capture <date>"
SHORELINE_DEMO_PLACE=
SHORELINE_DEMO_CAPTURED=
# optional: a command run with the batch summary as its last argument when `just batch` ends,
# e.g. a chat or desktop notifier
SHORELINE_NOTIFY_CMD=
# optional: a command run as `<cmd> <file> <caption>` by `just share`
SHORELINE_SHARE_CMD=
# optional: systemd unit on the GPU host to stop during `just batch` to free VRAM (needs
# passwordless sudo for `/usr/bin/systemctl stop|start <unit>`) and the host's ssh target
SHORELINE_STOP_SERVICE=
SHORELINE_GPU_HOST=
# M0 spike recipes only (spike/m0/justfile): working directory on the GPU host
SHORELINE_GPU_ROOT=
