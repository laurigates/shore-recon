# Copy to .env (git-ignored) or export in your shell. Read by the justfile's recipes.
# host tools file for shoreline-recon (ADR-0003, ADR-0009), e.g. configs/<host>.local.toml
SHORELINE_TOOLS=
# ssh target of the CUDA host that runs SfM, splats and renders
SHORELINE_GPU_HOST=
# working directory on that host; caches, envs and outputs all live under it
SHORELINE_GPU_ROOT=
# optional: datasets (configs/<name>.toml) for `just overnight`, `just demo` and `just bundle`
SHORELINE_DATASETS=
# optional: the demo title card and bundle README, e.g. "Reposalmi pier, Helsinki" and
# "drone capture 2026-10-23"
SHORELINE_DEMO_PLACE=
SHORELINE_DEMO_CAPTURED=
# optional: systemd unit to stop during gpu-overnight and `just overnight` to free VRAM
# (needs passwordless sudo for `/usr/bin/systemctl stop|start <unit>`)
SHORELINE_STOP_SERVICE=
