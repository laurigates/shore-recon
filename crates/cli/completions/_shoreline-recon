_shoreline-recon__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'shoreline-recon help help commands' commands "$@"
}
(( $+functions[_shoreline-recon__subcmd__help__subcmd__plan_commands] )) ||
_shoreline-recon__subcmd__help__subcmd__plan_commands() {
    local commands; commands=()
    _describe -t commands 'shoreline-recon help plan commands' commands "$@"
}
(( $+functions[_shoreline-recon__subcmd__help__subcmd__run_commands] )) ||
_shoreline-recon__subcmd__help__subcmd__run_commands() {
    local commands; commands=()
    _describe -t commands 'shoreline-recon help run commands' commands "$@"
}
(( $+functions[_shoreline-recon__subcmd__help__subcmd__tools_commands] )) ||
_shoreline-recon__subcmd__help__subcmd__tools_commands() {
    local commands; commands=()
    _describe -t commands 'shoreline-recon help tools commands' commands "$@"
}
(( $+functions[_shoreline-recon__subcmd__plan_commands] )) ||
_shoreline-recon__subcmd__plan_commands() {
    local commands; commands=()
    _describe -t commands 'shoreline-recon plan commands' commands "$@"
