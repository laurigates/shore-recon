_shoreline-recon__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'shoreline-recon help completions commands' commands "$@"
}
(( $+functions[_shoreline-recon__subcmd__help__subcmd__config_commands] )) ||
_shoreline-recon__subcmd__help__subcmd__config_commands() {
