# Segmentation backend for the masks stage (ADR-0006): OneFormer ADE20K Swin-L
# (MIT) on CPU torch, weights baked in at a pinned revision so the image digest
# pins code and weights together. Built and pushed by .github/workflows/containers.yml.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

LABEL org.opencontainers.image.source="https://github.com/laurigates/data-processing" \
      org.opencontainers.image.description="shoreline-recon masks backend: OneFormer ADE20K Swin-L"

ENV PATH=/opt/venv/bin:$PATH \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Everything in uv.lock, hashes checked; torch comes from PyTorch's CPU index (pyproject.toml).
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock /opt/segmentation/
RUN cd /opt/segmentation && uv sync --frozen --no-install-project \
    && python -c "import torch, sys; sys.exit(0 if torch.version.cuda is None else 'CUDA torch installed')"

ARG MODEL=shi-labs/oneformer_ade20k_swin_large
ARG MODEL_REVISION=4a5bac8e64f82681a12db2e151a4c2f4ce6092b2
ARG CLASS_INFO_REPO=shi-labs/oneformer_demo
ARG CLASS_INFO_REVISION=4d683bd5bf84e9c8b5537dce306230bde409fe89
COPY fetch_model.py /tmp/fetch_model.py
RUN python /tmp/fetch_model.py "${MODEL}" "${MODEL_REVISION}" "${CLASS_INFO_REPO}" \
        "${CLASS_INFO_REVISION}" /opt/models/oneformer \
    && rm -rf /tmp/fetch_model.py /root/.cache/huggingface

ENV SEGMENT_MODEL=/opt/models/oneformer \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY --chmod=755 segment.py /usr/local/bin/segment

# Fails the build if the dependencies, the weights or the default classes are broken.
RUN segment --check --classes water,sea,river,lake,sky,person,boat
