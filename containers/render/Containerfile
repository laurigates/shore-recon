# Showcase-video renderer for the video stage (ADR-0008, #29): render_video, a port of the M0
# spike's render_orbit.py, with gsplat 1.5.3 on torch 2.9.1 (CUDA 12.8) for splats, moderngl over
# headless EGL for meshes (ADR-0012), and a static ffmpeg with SVT-AV1. gsplat's CUDA extension is compiled here for sm_89 (RTX 4090), so nothing JIT-compiles
# at run time and the image needs no writable cache under Apptainer. Invoked as `render_video ...`
# under `apptainer exec --nv`; the entrypoint is not used.
# Built and pushed by .github/workflows/containers.yml.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04@sha256:520292dbb4f755fd360766059e62956e9379485d9e073bbd2f6e3c20c270ed66 AS build

ARG GSPLAT_SDIST=https://files.pythonhosted.org/packages/6d/94/a0963873708223385ac926112dc3e40ab08297784ac53d95309b4cb5a801/gsplat-1.5.3.tar.gz
ARG GSPLAT_SHA256=343f080c470e891ba3c697c03bdf0952cb982d1d535fdc24adb23c2cb4fba906
# BtbN static GPL build of the FFmpeg 9.0 release branch (includes libsvtav1). The dated
# autobuild releases are kept, unlike `latest`, which the spike used.
ARG FFMPEG_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-10-25-13-00/ffmpeg-n9.0.2-36-g6882969ce9-linux64-gpl-9.0.tar.xz
ARG FFMPEG_SHA256=fdcc15b1ba538ee94c087c1ce9c1efe166cfe392beb362ccb778f595065365cc

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl fonts-noto-core fonts-noto-mono \
        python3.12 python3.12-dev python3.12-venv xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.lock /tmp/requirements.lock
RUN python3.12 -m venv /opt/venv \
    && /opt/venv/bin/pip install --require-hashes --no-deps -r /tmp/requirements.lock \
    && /opt/venv/bin/python -c "import torch, sys; sys.exit(0 if torch.version.cuda == '12.8' else f'torch CUDA {torch.version.cuda}, want 12.8')"

# PyPI's gsplat wheel carries no compiled code, so build the sdist against the installed torch.
RUN curl -fsSL -o /tmp/gsplat.tar.gz "${GSPLAT_SDIST}" \
    && echo "${GSPLAT_SHA256}  /tmp/gsplat.tar.gz" | sha256sum -c - \
    && TORCH_CUDA_ARCH_LIST=8.9 MAX_JOBS=4 /opt/venv/bin/pip install --no-build-isolation --no-deps /tmp/gsplat.tar.gz \
    && so=$(/opt/venv/bin/python -c "import importlib.util as u; print(u.find_spec('gsplat.csrc').origin)") \
    && cuobjdump --list-elf "$so" | grep -q sm_89 \
    && rm /tmp/gsplat.tar.gz

RUN curl -fsSL -o /tmp/ffmpeg.tar.xz "${FFMPEG_URL}" \
    && echo "${FFMPEG_SHA256}  /tmp/ffmpeg.tar.xz" | sha256sum -c - \
    && mkdir /opt/ffmpeg \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /opt/ffmpeg --strip-components=2 --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && rm /tmp/ffmpeg.tar.xz

RUN mkdir /opt/fonts && cp /usr/share/fonts/truetype/noto/NotoSans-Regular.ttf \
        /usr/share/fonts/truetype/noto/NotoSans-Bold.ttf \
        /usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf /opt/fonts/

FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

LABEL org.opencontainers.image.source="https://github.com/laurigates/data-processing" \
      org.opencontainers.image.description="shoreline-recon showcase video renderer: gsplat 1.5.3 (CUDA sm_89), moderngl (EGL), SVT-AV1"

# libgomp1: gsplat's extension is built with -fopenmp against the system libgomp.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 python3.12 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/ffmpeg /usr/local/bin
COPY --from=build /opt/fonts /usr/share/fonts/render
COPY --chmod=755 render_video.py /usr/local/bin/render_video

ENV PATH=/opt/venv/bin:$PATH \
    SHORELINE_FONT_DIR=/usr/share/fonts/render \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Fails the build if the compiled extension does not load (torch, the CUDA user-space libraries
# and libgomp must resolve; the driver's libcuda comes from the host via --nv), if moderngl does
# not import, if ffmpeg lacks SVT-AV1, or if the CLI does not start. Rendering needs a GPU, which
# CI does not have: the GL and EGL libraries (glvnd's libOpenGL.so.0 and libEGL.so.1, and the
# NVIDIA vendor libraries) come from the host via --nv as well.
RUN python -c "import torch, gsplat.csrc; from gsplat import rasterization; print('gsplat', gsplat.__version__, 'torch', torch.__version__)" \
    && python -c "import moderngl; print('moderngl', moderngl.__version__)" \
    && ffmpeg -hide_banner -encoders | grep -q libsvtav1 \
    && ffprobe -version | head -n 1 \
    && render_video --help
