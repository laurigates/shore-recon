# Dense backend for machines without a CUDA host (ADR-0011): the same OpenMVS
# sources as containers/openmvs, built without CUDA for linux/arm64 (Docker on
# Apple Silicon) and linux/amd64. Densify and texturing run on the CPU: slower,
# same outputs. Built and pushed by .github/workflows/containers.yml as one index
# for both architectures.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS build

# Keep these in step with containers/openmvs/Containerfile.
ARG OPENMVS_COMMIT=eeedab7acceae48a92ddf44eaf4eb6ffe2fef14d
ARG VCG_COMMIT=658ba36d0a5666650da6e066b4794efc5a463407
ARG EIGEN_REF=3.4.0
ARG CGAL_REF=v6.0.1
ARG NANOFLANN_REF=v1.9.0
ARG OPENCV_REF=4.12.0

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git pkg-config \
        libboost-iostreams-dev libboost-program-options-dev libboost-serialization-dev \
        libboost-system-dev libboost-thread-dev libgmp-dev libmpfr-dev \
        libjpeg-dev libjxl-dev libpng-dev libtiff-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch "${OPENCV_REF}" https://github.com/opencv/opencv.git \
    && cmake -S opencv -B opencv/build -DCMAKE_BUILD_TYPE=Release -DWITH_JPEGXL=ON -DWITH_CUDA=OFF \
        -DBUILD_opencv_dnn=OFF -DBUILD_opencv_gapi=OFF -DBUILD_opencv_stitching=OFF \
        -DWITH_GTK=OFF -DWITH_QT=OFF -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF -DWITH_V4L=OFF \
        -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_opencv_apps=OFF \
        -DBUILD_opencv_python3=OFF -DBUILD_JAVA=OFF \
    && cmake --build opencv/build -j"$(nproc)" && cmake --install opencv/build && ldconfig \
    && rm -rf opencv
RUN git clone --depth 1 --branch "${EIGEN_REF}" https://gitlab.com/libeigen/eigen.git \
    && cmake -S eigen -B eigen/build && cmake --install eigen/build \
    && git clone --depth 1 --branch "${CGAL_REF}" https://github.com/CGAL/cgal.git \
    && cmake -S cgal -B cgal/build -DCMAKE_BUILD_TYPE=Release && cmake --install cgal/build \
    && git clone --depth 1 --branch "${NANOFLANN_REF}" https://github.com/jlblancoc/nanoflann.git \
    && cmake -S nanoflann -B nanoflann/build -DNANOFLANN_BUILD_EXAMPLES=OFF -DNANOFLANN_BUILD_TESTS=OFF \
    && cmake --install nanoflann/build \
    && git clone https://github.com/cdcseacave/VCG.git vcglib && git -C vcglib checkout --quiet "${VCG_COMMIT}" \
    && git init --quiet openMVS \
    && git -C openMVS fetch --quiet --depth 1 https://github.com/cdcseacave/openMVS.git "${OPENMVS_COMMIT}" \
    && git -C openMVS checkout --quiet FETCH_HEAD

RUN cmake -S openMVS -B openMVS/build -DCMAKE_BUILD_TYPE=Release -DVCG_ROOT=/src/vcglib \
        -DOpenMVS_USE_CUDA=OFF \
        -DOpenMVS_BUILD_VIEWER=OFF -DOpenMVS_USE_PYTHON=OFF -DOpenMVS_USE_BREAKPAD=OFF \
        -DOpenMVS_ENABLE_TESTS=OFF \
    && cmake --build openMVS/build -j"$(nproc)" \
    && cmake --install openMVS/build

# The Debian packages that own the binaries' shared libraries, for the runtime stage.
RUN ldd /usr/local/bin/OpenMVS/* | awk '/=> \// {print $3}' | xargs -r readlink -f | sort -u \
        | xargs -r dpkg -S 2>/dev/null | cut -d: -f1 | sort -u > /runtime-packages \
    && cat /runtime-packages && test -s /runtime-packages

FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

LABEL org.opencontainers.image.source="https://github.com/laurigates/shore-recon" \
      org.opencontainers.image.description="shoreline-recon dense backend: OpenMVS v2.4.0 (CPU)"

COPY --from=build /runtime-packages /tmp/runtime-packages
RUN apt-get update && xargs -a /tmp/runtime-packages apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/runtime-packages
COPY --from=build /usr/local/bin/OpenMVS /usr/local/bin/OpenMVS
COPY --from=build /usr/local/lib/libopencv_* /usr/local/lib/
RUN ldconfig
ENV PATH=/usr/local/bin/OpenMVS:$PATH

# Fails the build if a tool is missing, a library does not resolve, or a tool does not
# start. `--help` exits 1 after printing, so the banner is checked, not the status;
# it runs in a scratch directory because OpenMVS writes a log file to the cwd.
RUN for t in InterfaceCOLMAP DensifyPointCloud ReconstructMesh RefineMesh TextureMesh; do \
        test -x "/usr/local/bin/OpenMVS/$t" || { echo "missing $t"; exit 1; }; done; \
    missing=$(ldd /usr/local/bin/OpenMVS/* | grep 'not found' || true); \
    test -z "$missing" || { echo "$missing"; exit 1; }; \
    scratch=$(mktemp -d) && cd "$scratch" \
    && InterfaceCOLMAP --help 2>&1 | grep -q 'OpenMVS .* v2\.4\.0' \
    && cd / && rm -rf "$scratch"
